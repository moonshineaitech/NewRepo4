<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gong does not track users across apps or websites. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No tracking domains. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Gong collects no data whatsoever. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required-reason API declarations. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			Gong stores the resonance count and the Élite-owned flag in
			UserDefaults (directly and via @AppStorage). Both are read and
			written only by this app, for this app.
			CA92.1 = access info from same app, per Apple documentation.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
